mixin slide-trend(title, icon, items, colorClass, href)
  - const modifier = icon.name
  .slide-trend(class=`slide-trend--${colorClass}`, data-href=href, tabindex="0")
    .slide-trend__content(class=`slide-trend__content--${modifier}`)
      +icon(icon.name, icon.width, icon.height).slide-trend__image
      h3= title
      .slide-trend__text
        each item in items
          if Array.isArray(item)
            +ul(item[0], item[1])
          else
            ul.list-reset
              li= item

mixin ul(text, text2)
  ul.list-reset
    li= text
    if text2
      +icon("star", 16, 16).slide-trend__content-icon
      li.slide-trend__icon= text2

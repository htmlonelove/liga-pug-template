mixin career-card()
  .career-card
    .career-card__wrapper
      .career-card__description
        h2 UX/UI designer
        +icon("stars", 79, 14)
        p UX/UI-дизайнер&nbsp;&mdash; одна из&nbsp;самых востребованных профессий 2020 года
      ul.career-card__content.list-reset
        li 120&nbsp;000 рублей
        li 1&nbsp;561 компания
      ul.career-card__list.list-reset
        li.career-card__item.career-card__item--skillbox
          +icon("skillbox", 24, 24)
        li.career-card__item.career-card__item--skillfactory
          +icon("skillfactory", 24, 24)
        li.career-card__item.career-card__item--geekbrains
          +icon("geekbrains", 24, 24)
        li.career-card__item.career-card__item--netology
          +icon("netology", 24, 24)
        li.career-card__item.career-card__item--skypro
          +icon("skypro", 24, 24)

    }
  ]

mixin promo-slide(slide)
  .slide-promo__wrapper.swiper-slide(data-tabs="element", class=`slide-promo--${slide.modifier}`)
    .slide-promo__content
      .slide-promo__image
        +img(slide.image.folder, slide.image.name, slide.image.ext, slide.image.width, slide.image.height, slide.image.alt)
      h5= slide.subtitle
      p= slide.description

mixin tabs()
  .promo__tabs
    ul.promo__controls.list-reset(data-tabs="controls")
      each tab, index in tabsPromo
        li.promo__control(data-tabs="control", data-index=index, tabindex="0")
          .promo__tabs-img
            +icon(tab.icon, ...tab.iconSize).promo__tabs-icon
          h4= tab.title
          p= tab.description
